CORS_ORIGINS=["http://localhost:5173"]
DB_PATH=./data/app.db
# Secret: replace the value with the output of the command
JWT_SECRET=openssl rand -hex 32
# Set to true when served over HTTPS
COOKIE_SECURE=false

# Keitaro Admin API. URL may be given with a path (`tlgk.host/admin`), only the host is used.
KEITARO_URL=https://tlgk.host
# Profile -> API keys in the Keitaro admin panel
KEITARO_API_KEY=
KEITARO_TIMEZONE=Europe/Moscow
# Defaults for the creation form: domain kylovoa.com, group FORTESTS, traffic source FORTESTS
KEITARO_DEFAULT_DOMAIN_ID=1813
KEITARO_DEFAULT_GROUP_ID=10332
KEITARO_DEFAULT_TRAFFIC_SOURCE_ID=836
